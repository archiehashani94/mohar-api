   "seed": 1108,
   "version": 1,
   "versionNonce": 7763,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "type": "text",
   "x": 920,
   "y": 2137,
   "width": 368.94,
   "height": 247.5,
   "text": "wrap = ECIES(k → grantee pubkey)\n  (secp256k1 ECDH + sha256 + AES-GCM)\ngrantAccess(id, who, role, expiresAt, wrap)\n  Doctor role ⇒ Regulator.isClinician(who)\n  (NMC-verified) else revert\ndoctor: logAccess(id, purpose) FIRST\n  → AccessLogged on-chain → then decrypt\nrevoke: revokeAccess + re-encrypt with k′\n  → updateRecord(v+1); old grants are\n  bound to old keyVersion → dead\ncross-hospital: HAPI FHIR import +\n  ICD-10-CM search (73k codes)",
   "originalText": "wrap = ECIES(k → grantee pubkey)\n  (secp256k1 ECDH + sha256 + AES-GCM)\ngrantAccess(id, who, role, expiresAt, wrap)\n  Doctor role ⇒ Regulator.isClinician(who)\n  (NMC-verified) else revert\ndoctor: logAccess(id, purpose) FIRST\n  → AccessLogged on-chain → then decrypt\nrevoke: revokeAccess + re-encrypt with k′\n  → updateRecord(v+1); old grants are\n  bound to old keyVersion → dead\ncross-hospital: HAPI FHIR import +\n  ICD-10-CM search (73k codes)",
   "fontSize": 16.5,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25,
   "autoResize": true
