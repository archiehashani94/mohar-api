   "seed": 1105,
   "version": 1,
   "versionNonce": 7742,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "type": "text",
   "x": 60,
   "y": 2137,
   "width": 497.64000000000004,
   "height": 309.375,
   "text": "public (7): hospital_root, policy_commitment, nullifier,\n  claim_date, used_before, payout_amount, payout_recipient\nprivate: hospital secret + path, all policy fields,\n  ICD-10, procedure + path, bill[6], recordHash, sig\n\n1 Merkle(H(D_HOSP, secret)) == hospital_root\n2 Poseidon2(policy fields) == C; start ≤ date < end;\n  date ≥ waitingUntil\n3 Merkle(H(D_PROC, proc)) == coveredRoot;\n  diagnosis ∉ exclusions[4]\n4 payout == (Σbill − ded)(1 − copay);\n  used_before + payout ≤ sumInsured\n5 nullifier == Poseidon2(D_NUL, salt, recordHash, proc)\n6 ECDSA_verify(consentPub, sig, digest)\n7 recipient + payout bound inside digest",
   "originalText": "public (7): hospital_root, policy_commitment, nullifier,\n  claim_date, used_before, payout_amount, payout_recipient\nprivate: hospital secret + path, all policy fields,\n  ICD-10, procedure + path, bill[6], recordHash, sig\n\n1 Merkle(H(D_HOSP, secret)) == hospital_root\n2 Poseidon2(policy fields) == C; start ≤ date < end;\n  date ≥ waitingUntil\n3 Merkle(H(D_PROC, proc)) == coveredRoot;\n  diagnosis ∉ exclusions[4]\n4 payout == (Σbill − ded)(1 − copay);\n  used_before + payout ≤ sumInsured\n5 nullifier == Poseidon2(D_NUL, salt, recordHash, proc)\n6 ECDSA_verify(consentPub, sig, digest)\n7 recipient + payout bound inside digest",
   "fontSize": 16.5,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25,
   "autoResize": true
  },
