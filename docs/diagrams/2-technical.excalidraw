   "type": "text",
   "x": 2014,
   "y": 1340,
   "width": 300.3,
   "height": 288.75,
   "text": "require Regulator.isValidRoot(root)\nrequire policies[C].active\nrequire !nullifierUsed[N]\nrequire usedBefore == used[C]\nrequire date ∈ [now−90d, now+1h]\nrequire pool[insurer] ≥ payout\nHonkVerifier.verify(π, pub[7])\n  (gas-capped 6M, ~2.6M used)\n── effects ──\nnullifierUsed[N] = true\nused[C] += payout · pool −= payout\nbINR.transfer(R, payout)\nemit ClaimSettled(N, C, insurer,\n  payout, R, date)   ≈ 2.8M gas",
   "originalText": "require Regulator.isValidRoot(root)\nrequire policies[C].active\nrequire !nullifierUsed[N]\nrequire usedBefore == used[C]\nrequire date ∈ [now−90d, now+1h]\nrequire pool[insurer] ≥ payout\nHonkVerifier.verify(π, pub[7])\n  (gas-capped 6M, ~2.6M used)\n── effects ──\nnullifierUsed[N] = true\nused[C] += payout · pool −= payout\nbINR.transfer(R, payout)\nemit ClaimSettled(N, C, insurer,\n  payout, R, date)   ≈ 2.8M gas",
   "fontSize": 16.5,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25,
   "autoResize": true
