   "link": null,
   "locked": false,
   "type": "text",
   "x": 84,
   "y": 1062,
   "width": 609.96,
   "height": 143.75,
   "text": "Asha gives Dr. Meera a key that works for 24 hours.\nEvery time the doctor looks, it is written in a\npublic log Asha can read. She can take access\nback anytime — the safe simply gets a new lock.\nOnly government-registered doctors can be added.",
   "originalText": "Asha gives Dr. Meera a key that works for 24 hours.\nEvery time the doctor looks, it is written in a\npublic log Asha can read. She can take access\nback anytime — the safe simply gets a new lock.\nOnly government-registered doctors can be added.",
   "fontSize": 23,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25,
   "autoResize": true
  },
