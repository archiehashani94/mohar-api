   "link": null,
   "locked": false,
   "type": "text",
   "x": 1624,
   "y": 1062,
   "width": 574.08,
   "height": 143.75,
   "text": "Fake hospital? Expired policy? Claiming twice?\nChanging the amount? Splitting a big bill?\nSigning for the patient? Re-using someone\nelse's Aadhaar? → the proof can't even be made,\nor the robot judge rejects it. Live, every time.",
   "originalText": "Fake hospital? Expired policy? Claiming twice?\nChanging the amount? Splitting a big bill?\nSigning for the patient? Re-using someone\nelse's Aadhaar? → the proof can't even be made,\nor the robot judge rejects it. Live, every time.",
   "fontSize": 23,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25,
   "autoResize": true
  },
