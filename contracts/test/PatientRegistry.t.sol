pragma solidity ^0.8.27;

import {Test} from "forge-std/Test.sol";
import {PatientRegistry} from "../src/PatientRegistry.sol";
import {AnonAadhaar} from "../src/AnonAadhaar.sol";
import {Verifier} from "../src/AnonAadhaarVerifier.sol";
import {IAnonAadhaar} from "../interfaces/IAnonAadhaar.sol";

/// Uses REAL Anon Aadhaar Groth16 proofs (test-mode UIDAI key) generated by sdk/scripts/aadhaar-prove.mjs.
contract PatientRegistryTest is Test {
    PatientRegistry reg;
    address asha = 0x3C44CdDdB6a900fa2b585dd299e03d12FA4293BC;
    address rahul = 0x90F79bf6EB2c4f870365E785982E1f101E93b906;

    struct P {
        uint256 seed;
        uint256 nullifier;
        uint256 timestamp;
        uint256[4] reveal;
        uint256[8] proof;
    }

    function _load(string memory f) internal view returns (P memory p) {
        string memory j = vm.readFile(f);
        p.seed = vm.parseJsonUint(j, ".nullifierSeed");
        p.nullifier = vm.parseJsonUint(j, ".nullifier");
        p.timestamp = vm.parseJsonUint(j, ".timestamp");
        uint256[] memory r = vm.parseJsonUintArray(j, ".revealArray");
        uint256[] memory g = vm.parseJsonUintArray(j, ".groth16Proof");
        for (uint256 i; i < 4; i++) p.reveal[i] = r[i];
        for (uint256 i; i < 8; i++) p.proof[i] = g[i];
    }

    function setUp() public {
        AnonAadhaar aa = new AnonAadhaar(address(new Verifier()), 15134874015316324267425466444584014077184337590635665158241104437045239495873);
        reg = new PatientRegistry(IAnonAadhaar(address(aa)), 11651504, true);
    }

    function test_realAadhaarProofVerifies() public {
        P memory p = _load("test/fixtures/aadhaar-asha.json");
        uint256 g0 = gasleft();
        vm.prank(asha);
        reg.verifyWithAadhaar(p.seed, p.nullifier, p.timestamp, p.reveal, p.proof);
        emit log_named_uint("gas verifyWithAadhaar", g0 - gasleft());
        assertTrue(reg.isVerified(asha));
    }

    function test_attack_stolenProofOtherWallet() public {
        P memory p = _load("test/fixtures/aadhaar-asha.json");
        vm.prank(rahul); // signal is bound to asha's address
        vm.expectRevert(PatientRegistry.InvalidAadhaarProof.selector);
        reg.verifyWithAadhaar(p.seed, p.nullifier, p.timestamp, p.reveal, p.proof);
    }

    function test_attack_sameAadhaarTwoAccounts() public {
        P memory a = _load("test/fixtures/aadhaar-asha.json");
        P memory r = _load("test/fixtures/aadhaar-rahul.json");
        vm.prank(asha);
        reg.verifyWithAadhaar(a.seed, a.nullifier, a.timestamp, a.reveal, a.proof);
        vm.prank(rahul); // valid proof for rahul's wallet, but the SAME Aadhaar → same nullifier
        vm.expectRevert(abi.encodeWithSelector(PatientRegistry.DuplicateAadhaar.selector, asha));
        reg.verifyWithAadhaar(r.seed, r.nullifier, r.timestamp, r.reveal, r.proof);
    }

    function test_attack_tamperedReveal() public {
        P memory p = _load("test/fixtures/aadhaar-asha.json");
        p.reveal[3] = 123; // claim a different state
        vm.prank(asha);
        vm.expectRevert(PatientRegistry.InvalidAadhaarProof.selector);
        reg.verifyWithAadhaar(p.seed, p.nullifier, p.timestamp, p.reveal, p.proof);
    }

    function test_wrongSeed() public {
        P memory p = _load("test/fixtures/aadhaar-asha.json");
        vm.prank(asha);
        vm.expectRevert(PatientRegistry.WrongSeed.selector);
        reg.verifyWithAadhaar(1234, p.nullifier, p.timestamp, p.reveal, p.proof);
    }
}
